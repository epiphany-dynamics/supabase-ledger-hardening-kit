# Copy this file to .env and fill in your own values. Never commit .env.
#
# --- ledger/ demo (concurrency-safe balance pattern) -------------------
# Any reachable Postgres 13+ database: local Postgres, a Supabase project's
# connection string (Project Settings -> Database -> Connection string),
# or any other Postgres host. The demo will create its own "accounts" and
# "ledger_entries" tables, so point this at a scratch database or schema,
# not a production database with tables you care about.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres

# Port for the local HTTP wrapper used by the k6 load test (ledger/server.mjs)
LEDGER_SERVER_PORT=8787

# --- rls-test-harness/ (RLS audit against a real Supabase project) -----
# Found in Supabase dashboard: Project Settings -> API.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key

# Optional but recommended: enables the "is RLS enabled at all" check.
# Treat this like a root password. Never expose it client-side.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: a second real test user's access token, needed only for the
# cross-user read/write isolation probes. See rls-test-harness/README.md.
SUPABASE_OTHER_USER_JWT=
