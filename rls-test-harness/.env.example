# Copy this file to .env at the repo root (or export these directly) before
# running the RLS audit. Never commit real values.

# Required. Found in Supabase dashboard: Project Settings -> API.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key

# Optional but recommended. Enables the "is RLS enabled at all" check via
# rls-test-harness/sql/introspection_helper.sql. Treat this key like a
# root password: never expose it client-side, never commit it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional. A real access token (JWT) for a SECOND test user account,
# different from whichever user you consider "self" in your test data.
# Needed only for the cross-user read/write probes. Get this by signing in
# as a second test user via your app or via supabase.auth.signInWithPassword
# and reading the resulting session.access_token.
SUPABASE_OTHER_USER_JWT=
